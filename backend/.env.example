# ==============================================================================
# OXYGEN DUELS REST API CONFIGURATION
# ==============================================================================

# Port the backend API listens on
PORT=3001

# Allowed origins for CORS (comma-separated or * for development)
# In production, set to your Cloudflare Pages domain:
CORS_ORIGIN=https://samratnagarkoti.com.np,https://*.pages.dev,http://localhost:3000,http://localhost:5500,*

# ------------------------------------------------------------------------------
# PTERODACTYL MYSQL DATABASE CONFIGURATION
# Copy these from your Pterodactyl Panel -> "Databases" tab
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=u1_oxygen
DB_PASSWORD=your_strong_petro_db_password
DB_NAME=s1_oxygen_db
DB_SSL=false
DB_CONNECTION_LIMIT=10

# ------------------------------------------------------------------------------
# PTERODACTYL MINECRAFT SERVER DETAILS
# Used for real-time live player ping, MOTD, and online status indicator
# ------------------------------------------------------------------------------
MINECRAFT_HOST=play.samratnagarkoti.com.np
MINECRAFT_PORT=25565
SERVER_DISPLAY_NAME="Oxygen PvP"
